{
  "expo": {
    "name": "Zero Trap",
    "slug": "zero-trap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF3B30"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zerotrap.emergency"
    },
    "android": {
      "package": "com.zerotrap.emergency",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF3B30"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCR34xAzwjLJAmsbIbBXuC_udV2rbQwgMo"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Zero Trap needs your location for emergency help requests.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "a4292b6d-747f-46d3-8d5b-034b2608ddcd"
      }
    }
  }
}
